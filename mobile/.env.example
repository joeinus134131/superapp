# ========== BACKEND API ==========
# URL of the Go backend API (include /api/v1)
# For local dev, use your machine IP (not localhost) so Android emulator can reach it
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8080/api/v1

# ========== SUPABASE ==========
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ========== AI (NLP Parsing) ==========
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key
