{
  "name": "@superapp/mobile",
  "version": "1.0.0",
  "description": "SelfOne Mobile - React Native with Expo",
  "main": "expo-router/entry",
  "scripts": {
    "preflight": "node ./scripts/preflight.mjs",
    "preflight:android": "node ./scripts/preflight.mjs android",
    "dev": "pnpm run preflight && expo start --go",
    "dev:clear": "pnpm run preflight && expo start --go -c",
    "start": "pnpm run preflight && expo start --go",
    "dev:simulator": "node ./scripts/ios-simulator.mjs",
    "dev:client": "pnpm run preflight && expo start --dev-client",
    "android": "pnpm run preflight:android && expo run:android",
    "ios": "pnpm run preflight && expo run:ios",
    "web": "pnpm run preflight && expo start --web",
    "test": "jest --passWithNoTests",
    "build": "pnpm run preflight && pnpm dlx eas-cli build --platform all --profile production",
    "build:android": "pnpm run preflight && pnpm dlx eas-cli build --platform android --profile production",
    "build:ios": "pnpm run preflight && pnpm dlx eas-cli build --platform ios --profile production",
    "build:preview": "pnpm run preflight && pnpm dlx eas-cli build --platform all --profile preview",
    "build:dev": "pnpm run preflight && pnpm dlx eas-cli build --platform all --profile development",
    "submit:android": "pnpm dlx eas-cli submit --platform android --profile production",
    "submit:ios": "pnpm dlx eas-cli submit --platform ios --profile production",
    "update": "pnpm dlx eas-cli update --branch production",
    "oauth:check": "node ./scripts/oauth-preflight.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "^57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@supabase/supabase-js": "^2.38.0",
    "@superapp/shared": "workspace:*",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.15.2",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "^57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.23",
    "expo-network": "^57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "invariant": "^2.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "^19.1.17",
    "@types/react-native": "^0.72.0",
    "babel-preset-expo": "~57.0.16",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "expo": {
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
