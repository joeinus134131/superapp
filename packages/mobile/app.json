{
  "expo": {
    "name": "SelfOne - Smart Assistant",
    "slug": "selfone-mobile",
    "version": "1.0.0",
    "scheme": "selfone",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f17"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.selfone.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Digunakan untuk mengambil foto profil.",
        "NSPhotoLibraryUsageDescription": "Digunakan untuk memilih foto dari galeri.",
        "NSPhotoLibraryAddUsageDescription": "Digunakan untuk menyimpan foto.",
        "NSLocalNotificationUsageDescription": "Digunakan untuk pengingat habit, task, dan pomodoro.",
        "NSUserNotificationUsageDescription": "Digunakan untuk pengingat habit, task, dan pomodoro.",
        "NSHealthShareUsageDescription": "Digunakan untuk membaca data kesehatan (opsional).",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.selfone.mobile",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-router",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-secure-store"
    ],
    "extra": {
      "supabaseUrl": "https://bdtsztphkqmpzrqascdl.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJkdHN6dHBoa3FtcHpycWFzY2RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzcyMDYxNjUsImV4cCI6MjA5Mjc4MjE2NX0.vfeQlQy-eeltUWiYLzW9MDrFiGGiypH53soeCC5AsNM",
