{
  "name": "@superapp/mobile",
  "version": "1.0.0",
  "description": "SuperApp Mobile - React Native with Expo",
  "main": "expo-router/entry",
  "scripts": {
    "preflight": "node ./scripts/preflight.mjs",
    "preflight:android": "node ./scripts/preflight.mjs android",
    "dev": "pnpm run preflight && expo start",
    "start": "pnpm run preflight && expo start",
    "android": "pnpm run preflight:android && expo run:android",
    "ios": "pnpm run preflight && expo run:ios",
    "web": "pnpm run preflight && expo start --web",
    "test": "jest",
    "build": "pnpm run preflight && eas build --platform all --profile production",
    "build:android": "pnpm run preflight && eas build --platform android --profile production",
    "build:ios": "pnpm run preflight && eas build --platform ios --profile production",
    "build:preview": "pnpm run preflight && eas build --platform all --profile preview",
    "build:dev": "pnpm run preflight && eas build --platform all --profile development",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update": "eas update --branch production"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-modules-core": "~3.0.30",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "invariant": "^2.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.2",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "^19.1.17",
    "@types/react-native": "^0.72.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  },
  "expo": {
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
