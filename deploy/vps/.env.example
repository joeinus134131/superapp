# Copy to .env in this directory. Point domain DNS to the VPS first.
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=whenya
POSTGRES_DB=whenya
# Use a random hexadecimal value: openssl rand -hex 32
POSTGRES_PASSWORD=
# Public Supabase project configuration; Auth remains hosted by Supabase.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Public browser values are baked into the web image. Rebuild after changes.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_PRODUCTION=false
# For prebuilt image distribution, set registry paths and an immutable release tag.
API_IMAGE=whenya-api
WEB_IMAGE=whenya-web
WHENYA_RELEASE=local
