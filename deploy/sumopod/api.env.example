# Server only. Copy to api.env on the VPS; never put these secrets in EXPO_PUBLIC_*.
# Use the existing database selected for this deployment. Remote connections need TLS.
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Browser origin of the actual web app; native Android does not use browser CORS.
CORS_ALLOWED_ORIGINS=https://YOUR_WEB_DOMAIN
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME_MINUTES=30
# Optional features: leave blank until their services are configured.
GROQ_API_KEY=
CLAUDE_API_KEY=
FINLAB_BASE_URL=
FINLAB_DELEGATION_SECRET=
FINLAB_ALLOW_INSECURE_HTTP=false
FINANCE_VAULT_DRIVER=
FINANCE_VAULT_LOCAL_ROOT=
