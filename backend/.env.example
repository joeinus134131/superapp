# Copy this file to .env and fill in your values.
# The server will not start without DATABASE_URL and one JWT verifier.

PORT=8080
DATABASE_URL=postgres://selfone:CHANGE_ME@localhost:5433/selfone?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# REQUIRED: Configure at least one JWT verification method.
# Preferred: verify Supabase asymmetric access tokens (ES256/RS256) via JWKS.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Optional HMAC fallback for legacy HS256 tokens. Must be a strong secret.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# AI Service Keys (optional, for AI features)
GROQ_API_KEY=your-groq-key
CLAUDE_API_KEY=your-claude-key

# Staging least-privilege runtime: migration role applies schema separately.
SKIP_AUTO_MIGRATION=true
# Optional private FinLab service. Blank = BFF returns research_not_configured.
FINLAB_BASE_URL=
FINLAB_DELEGATION_SECRET=
# Explicitly enable only for an owner-confirmed private HTTP network; prefer HTTPS.
FINLAB_ALLOW_INSECURE_HTTP=false

# Optional private LOCAL STAGING archive. Blank driver disables document storage.
# This is not a production object-store deployment configuration.
FINANCE_VAULT_DRIVER=
FINANCE_VAULT_LOCAL_ROOT=
