# ========== BACKEND API ==========
# URL of the Go backend API (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ========== SUPABASE ==========
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ========== E2E ENCRYPTION ==========
# Default encryption key for cloud sync (users can override via Settings)
NEXT_PUBLIC_ENCRYPTION_KEY=your-default-encryption-secret

# ========== MIDTRANS PAYMENT GATEWAY ==========
# Get your keys from: https://dashboard.midtrans.com

# Server Key - Keep this SECRET, only use on server-side
MIDTRANS_SERVER_KEY=Mid-server-YOUR_SANDBOX_SERVER_KEY_HERE
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-YOUR_SANDBOX_CLIENT_KEY_HERE

# Set to true for production, false for sandbox
NEXT_PUBLIC_MIDTRANS_PRODUCTION=false
