{
  "name": "@superapp/shared",
  "version": "1.0.0",
  "description": "Shared logic and utilities for SuperApp web and mobile",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./auth": "./lib/auth.js",
    "./gamification": "./lib/gamification.js",
    "./token-system": "./lib/tokenSystem.js",
    "./premium": "./lib/premium.js",
    "./storage": "./lib/storage.js",
    "./supabase": "./lib/supabaseClient.js",
    "./cloud-auth": "./lib/cloudAuth.js",
    "./helpers": "./lib/helpers.js",
    "./notifications": "./lib/notifications.js",
    "./backup": "./lib/backup.js",
    "./cloud-sync": "./lib/cloudSync.js",
    "./dictionaries": "./lib/dictionaries.js",
    "./translations": "./lib/translations.js",
    "./language": "./lib/language.js",
    "./roast": "./lib/roast.js",
    "./sounds": "./lib/sounds.js",
    "./insights": "./lib/insights.js",
    "./brand-visuals": "./lib/brandVisuals.js",
    "./database-sync": "./lib/databaseSync.js",
    "./tasks": "./lib/tasks.js",
    "./goals": "./lib/goals.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "crypto-js": "^4.2.0"
