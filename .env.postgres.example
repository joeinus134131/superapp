# Used by docker-compose.yml. Copy to .env and replace both passwords.
POSTGRES_USER=selfone
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=selfone
POSTGRES_PORT=5433
PGADMIN_DEFAULT_EMAIL=admin@localhost.test
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_PASSWORD
PGADMIN_PORT=5050

# Backend connection string when the API runs on the host:
# DATABASE_URL=postgres://selfone:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@localhost:5433/selfone?sslmode=disable
# When the API runs inside the same Compose network, use host `db` and port 5432.
